# --- Access ---
# The PIN you type to open the site. Use 6+ digits.
APP_PIN=482915
# Optional: secret used to sign the login cookie. If unset, the Supabase server key is used.
# SESSION_SECRET=

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "service_role" / secret key. Server-side only — never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (aistudio.google.com → Get API key) — free tier ---
GEMINI_API_KEY=
# Optional: override the model. gemini-3.5-flash-lite is faster with higher free limits, but less accurate.
# GEMINI_MODEL=gemini-3.8-flash

# --- Brave Search (api-dashboard.search.brave.com) — $5 free credit/month ---
# Finds recent sale prices and a clean picture of the card.
# Without it, the app uses your photo and Gemini's own knowledge for values.
BRAVE_SEARCH_API_KEY=

# --- Optional ---
# Pokémon TCG API key (pokemontcg.io) — higher rate limits for Pokémon lookups.
# POKEMON_TCG_API_KEY=
# Used only if the live exchange-rate lookup fails.
# FALLBACK_USD_AUD=1.52
